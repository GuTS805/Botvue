# Hedera testnet credentials from https://portal.hedera.com
# Copy "HEX Encoded Private Key" (ECDSA account) or "DER Encoded Private Key" (ED25519).
# The 0x prefix is fine. The EVM Address is NOT a key.
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=
HEDERA_NETWORK=testnet

# Set after running: npm run create-topic
HEDERA_TOPIC_ID=
